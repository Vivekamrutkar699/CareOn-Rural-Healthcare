<div class="max-w-6xl mx-auto">

    <!-- Page Header -->
    <div class="mb-8">
        <div class="flex items-center gap-3 mb-2">

            <div
                class="w-11 h-11 rounded-xl bg-green-100
                       text-green-600 flex items-center justify-center"
            >
                <i class="fa-solid fa-video text-lg"></i>
            </div>

            <div>
                <h1 class="text-3xl font-bold text-gray-800">
                    Telemedicine
                </h1>

                <p class="text-gray-500 mt-1">
                    Connect patients with healthcare professionals remotely.
                </p>
            </div>

        </div>
    </div>


    <!-- Pending Consultation Requests -->
    <section class="mb-8">

        <div class="flex items-center justify-between mb-4">

            <div>
                <h2 class="text-xl font-bold text-gray-800">
                    Consultation Requests
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                    Review patient requests and schedule consultations.
                </p>
            </div>

            <span
                class="px-3 py-1 rounded-full text-xs font-semibold
                       bg-orange-50 text-orange-600"
            >
                Pending
            </span>

        </div>


        <div
            id="pending-requests-container"
            class="space-y-4"
        >

            <!-- Demo Pending Request -->
            <div
                class="request-card bg-white rounded-2xl
                       border border-gray-100 shadow-sm p-5"
                data-patient-id="PAT-001"
                data-patient-name="Rahul Sharma"
            >

                <div
                    class="flex flex-col md:flex-row
                           md:items-center md:justify-between gap-5"
                >

                    <div class="flex items-start gap-4">

                        <div
                            class="w-12 h-12 shrink-0 rounded-xl
                                   bg-blue-100 text-blue-600
                                   flex items-center justify-center"
                        >
                            <i class="fa-solid fa-user text-lg"></i>
                        </div>

                        <div>
                            <h3 class="font-bold text-gray-800">
                                Rahul Sharma
                            </h3>

                            <p class="text-sm text-gray-500 mt-1">
                                Patient ID:
                                <span class="font-medium">
                                    PAT-001
                                </span>
                            </p>

                            <p class="text-sm text-gray-500 mt-1">
                                Requesting a remote healthcare consultation.
                            </p>
                        </div>

                    </div>


                    <div
                        class="flex flex-col sm:flex-row gap-2"
                    >

                        <button
                            type="button"
                            class="schedule-btn px-4 py-2.5 rounded-xl
                                   bg-green-600 text-white
                                   font-semibold text-sm
                                   hover:bg-green-700 transition
                                   flex items-center justify-center gap-2"
                        >
                            <i class="fa-solid fa-calendar-plus"></i>
                            Accept & Schedule
                        </button>

                        <button
                            type="button"
                            class="decline-btn px-4 py-2.5 rounded-xl
                                   bg-gray-100 text-gray-600
                                   font-semibold text-sm
                                   hover:bg-red-50 hover:text-red-600
                                   transition
                                   flex items-center justify-center gap-2"
                        >
                            <i class="fa-solid fa-xmark"></i>
                            Decline
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Upcoming Appointments -->
    <section class="mb-8">

        <div class="mb-4">
            <h2 class="text-xl font-bold text-gray-800">
                Upcoming Appointments
            </h2>

            <p class="text-sm text-gray-500 mt-1">
                Manage scheduled consultations and join active calls.
            </p>
        </div>


        <div
            id="upcoming-appointments-container"
            class="space-y-4"
        >

            <!-- Empty State -->
            <div
                id="appointments-empty-state"
                class="bg-white rounded-2xl
                       border border-dashed border-gray-300
                       p-8 text-center"
            >

                <div
                    class="w-14 h-14 mx-auto mb-4 rounded-full
                           bg-gray-100 text-gray-400
                           flex items-center justify-center"
                >
                    <i class="fa-regular fa-calendar text-xl"></i>
                </div>

                <h3 class="font-semibold text-gray-700">
                    No upcoming appointments
                </h3>

                <p class="text-sm text-gray-400 mt-1">
                    Scheduled consultations will appear here.
                </p>

            </div>

        </div>

    </section>


    <!-- How Telemedicine Works -->
    <section
        class="bg-white rounded-2xl shadow-sm
               border border-gray-100 p-6 md:p-8 mb-8"
    >

        <div class="mb-7">
            <h2 class="text-2xl font-bold text-gray-800">
                How Telemedicine Works
            </h2>

            <p class="text-gray-500 mt-1">
                Connect patients with healthcare professionals in three steps.
            </p>
        </div>


        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Step 1 -->
            <div>

                <div
                    class="w-12 h-12 rounded-xl bg-blue-100
                           text-blue-600 flex items-center
                           justify-center mb-4"
                >
                    <i class="fa-solid fa-calendar-plus text-lg"></i>
                </div>

                <span
                    class="text-xs font-bold text-blue-600 tracking-wide"
                >
                    STEP 01
                </span>

                <h3 class="text-lg font-bold text-gray-800 mt-1 mb-2">
                    Book
                </h3>

                <p class="text-sm text-gray-500 leading-relaxed">
                    Review a patient request and schedule a suitable
                    consultation date and time.
                </p>

            </div>


            <!-- Step 2 -->
            <div>

                <div
                    class="w-12 h-12 rounded-xl bg-green-100
                           text-green-600 flex items-center
                           justify-center mb-4"
                >
                    <i class="fa-solid fa-link text-lg"></i>
                </div>

                <span
                    class="text-xs font-bold text-green-600 tracking-wide"
                >
                    STEP 02
                </span>

                <h3 class="text-lg font-bold text-gray-800 mt-1 mb-2">
                    Connect
                </h3>

                <p class="text-sm text-gray-500 leading-relaxed">
                    Join the remote consultation when the appointment
                    enters its active time window.
                </p>

            </div>


            <!-- Step 3 -->
            <div>

                <div
                    class="w-12 h-12 rounded-xl bg-purple-100
                           text-purple-600 flex items-center
                           justify-center mb-4"
                >
                    <i class="fa-solid fa-user-doctor text-lg"></i>
                </div>

                <span
                    class="text-xs font-bold text-purple-600 tracking-wide"
                >
                    STEP 03
                </span>

                <h3 class="text-lg font-bold text-gray-800 mt-1 mb-2">
                    Consult
                </h3>

                <p class="text-sm text-gray-500 leading-relaxed">
                    Discuss symptoms and healthcare concerns with
                    a qualified healthcare professional.
                </p>

            </div>

        </div>

    </section>


    <!-- Platform Features -->
    <section class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <div
            class="bg-white rounded-xl border border-gray-100
                   p-5"
        >
            <div
                class="w-10 h-10 rounded-lg bg-green-100
                       text-green-600 flex items-center
                       justify-center mb-3"
            >
                <i class="fa-solid fa-user-doctor"></i>
            </div>

            <h3 class="font-semibold text-gray-800">
                Healthcare Professionals
            </h3>

            <p class="text-sm text-gray-500 mt-1 leading-relaxed">
                Connect patients with healthcare professionals remotely.
            </p>
        </div>


        <div
            class="bg-white rounded-xl border border-gray-100
                   p-5"
        >
            <div
                class="w-10 h-10 rounded-lg bg-blue-100
                       text-blue-600 flex items-center
                       justify-center mb-3"
            >
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h3 class="font-semibold text-gray-800">
                Secure Communication
            </h3>

            <p class="text-sm text-gray-500 mt-1 leading-relaxed">
                Designed to support secure remote healthcare consultations.
            </p>
        </div>


        <div
            class="bg-white rounded-xl border border-gray-100
                   p-5"
        >
            <div
                class="w-10 h-10 rounded-lg bg-orange-100
                       text-orange-600 flex items-center
                       justify-center mb-3"
            >
                <i class="fa-solid fa-clock"></i>
            </div>

            <h3 class="font-semibold text-gray-800">
                Flexible Access
            </h3>

            <p class="text-sm text-gray-500 mt-1 leading-relaxed">
                Reduce travel barriers and make healthcare more accessible.
            </p>
        </div>

    </section>

</div>


<!-- Schedule Appointment Modal -->
<div
    id="schedule-modal"
    class="hidden fixed inset-0 z-50
           bg-black/50 backdrop-blur-sm
           flex items-center justify-center
           p-4"
>

    <div
        class="bg-white w-full max-w-md
               rounded-2xl shadow-xl"
    >

        <!-- Modal Header -->
        <div
            class="flex items-center justify-between
                   px-6 py-5 border-b border-gray-100"
        >

            <div>
                <h2 class="text-xl font-bold text-gray-800">
                    Schedule Consultation
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                    Appointment for
                    <span
                        id="modal-patient-name"
                        class="font-semibold text-gray-700"
                    ></span>
                </p>
            </div>

            <button
                id="close-modal-btn"
                type="button"
                class="w-9 h-9 rounded-lg
                       text-gray-400 hover:bg-gray-100
                       hover:text-gray-600 transition"
            >
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>


        <!-- Modal Body -->
        <form
            id="schedule-form"
            class="p-6"
        >

            <input
                type="hidden"
                id="patient-id-input"
            >

            <input
                type="hidden"
                id="patient-name-input"
            >


            <!-- Date -->
            <div class="mb-5">

                <label
                    for="appointment-date"
                    class="block text-sm font-semibold
                           text-gray-700 mb-2"
                >
                    Appointment Date
                </label>

                <input
                    type="date"
                    id="appointment-date"
                    required
                    class="w-full px-4 py-3 rounded-xl
                           border border-gray-200
                           focus:outline-none focus:ring-2
                           focus:ring-green-500/30
                           focus:border-green-500"
                >

            </div>


            <!-- Time -->
            <div class="mb-6">

                <label
                    for="appointment-time"
                    class="block text-sm font-semibold
                           text-gray-700 mb-2"
                >
                    Appointment Time
                </label>

                <input
                    type="time"
                    id="appointment-time"
                    required
                    class="w-full px-4 py-3 rounded-xl
                           border border-gray-200
                           focus:outline-none focus:ring-2
                           focus:ring-green-500/30
                           focus:border-green-500"
                >

            </div>


            <!-- Info -->
            <div
                class="bg-blue-50 border border-blue-100
                       rounded-xl p-4 mb-6"
            >

                <div class="flex items-start gap-3">

                    <i
                        class="fa-solid fa-circle-info
                               text-blue-500 mt-0.5"
                    ></i>

                    <p class="text-sm text-blue-700 leading-relaxed">
                        The video consultation becomes available
                        10 minutes before the scheduled time and
                        remains available for up to 60 minutes afterward.
                    </p>

                </div>

            </div>


            <!-- Actions -->
            <div class="flex gap-3">

                <button
                    id="cancel-schedule-btn"
                    type="button"
                    class="flex-1 px-4 py-3 rounded-xl
                           bg-gray-100 text-gray-600
                           font-semibold hover:bg-gray-200
                           transition"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="flex-1 px-4 py-3 rounded-xl
                           bg-green-600 text-white
                           font-semibold hover:bg-green-700
                           transition flex items-center
                           justify-center gap-2"
                >
                    <i class="fa-solid fa-calendar-check"></i>
                    Schedule
                </button>

            </div>

        </form>

    </div>

</div>


<script src="/js/telemedicine.js"></script>