<!-- CareOn Navbar -->

<nav class="bg-white shadow-md sticky top-0 z-50 border-b">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="flex items-center justify-between h-16">

            <!-- Logo -->

            <div class="flex-shrink-0">

                <a
                    href="/"
                    class="flex items-center text-2xl font-bold text-gray-800"
                >

                    <i
                        class="fa-solid fa-heart-pulse mr-2"
                        style="color: #3b82f6;"
                    ></i>

                    <span>
                        Care<span style="color: #3b82f6;">On</span>
                    </span>

                </a>

            </div>


            <!-- Desktop Navigation -->

            <div class="hidden md:block">

                <div class="ml-10 flex items-center space-x-2">

                    <!-- Home -->

                    <a
                        href="/"
                        class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                    >
                        Home
                    </a>


                    <!-- Dashboard -->

                    <a
                        href="/dashboard"
                        class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                    >
                        Dashboard
                    </a>


                    <!-- Patients - Doctor/Admin only -->

                    <% if (user && (user.role === "DOCTOR" || user.role === "ADMIN")) { %>

                        <a
                            href="/patients"
                            class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                        >
                            Patients
                        </a>

                    <% } %>


                    <!-- AI Assistant - Patient/Doctor -->

                    <% if (user && (user.role === "PATIENT" || user.role === "DOCTOR")) { %>

                        <a
                            href="/ai-assistant"
                            class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                        >
                            AI Assistant
                        </a>

                    <% } %>


                    <!-- Telemedicine - Patient/Doctor -->

                    <% if (user && (user.role === "PATIENT" || user.role === "DOCTOR")) { %>

                        <a
                            href="/telemedicine"
                            class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                        >
                            Telemedicine
                        </a>

                    <% } %>


                    <!-- Medicine - All authenticated users -->

                    <% if (user) { %>

                        <a
                            href="/medicine"
                            class="text-gray-600 hover:bg-blue-50 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-semibold transition"
                        >
                            Medicine
                        </a>

                    <% } %>

                </div>

            </div>


            <!-- User / Authentication -->

            <div class="hidden md:flex items-center gap-3 ml-4">

                <% if (user) { %>

                    <div class="flex items-center gap-3">

                        <!-- User Avatar -->

                        <div
                            class="w-9 h-9 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center"
                        >
                            <i class="fa-solid fa-user"></i>
                        </div>


                        <!-- User Details -->

                        <div class="leading-tight">

                            <p class="text-sm font-semibold text-gray-800">
                                <%= user.name %>
                            </p>

                            <p class="text-xs text-gray-500">
                                <%= user.role %>
                            </p>

                        </div>


                        <!-- Logout -->

                        <form method="POST" action="/logout">

                            <button
                                type="submit"
                                class="ml-2 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50 rounded-lg transition"
                            >

                                <i class="fa-solid fa-right-from-bracket mr-1"></i>

                                Logout

                            </button>

                        </form>

                    </div>

                <% } else { %>

                    <!-- Login -->

                    <a
                        href="/login"
                        class="px-4 py-2 text-sm font-semibold text-blue-600 hover:bg-blue-50 rounded-lg transition"
                    >
                        Login
                    </a>


                    <!-- Register -->

                    <a
                        href="/register"
                        class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-lg transition"
                    >
                        Register
                    </a>

                <% } %>

            </div>


            <!-- Mobile Menu Button -->

            <div class="-mr-2 flex md:hidden">

                <button
                    id="mobile-menu-button"
                    type="button"
                    class="bg-white inline-flex items-center justify-center p-2 rounded-md text-gray-500 hover:text-gray-700 focus:outline-none"
                >

                    <i class="fa-solid fa-bars text-xl"></i>

                </button>

            </div>

        </div>

    </div>


    <!-- Mobile Navigation -->

    <div
        class="md:hidden hidden"
        id="mobile-menu"
    >

        <div class="px-2 pt-2 pb-3 space-y-1">

            <!-- Home -->

            <a
                href="/"
                class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
            >
                Home
            </a>


            <!-- Dashboard -->

            <a
                href="/dashboard"
                class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
            >
                Dashboard
            </a>


            <!-- Patients - Doctor/Admin only -->

            <% if (user && (user.role === "DOCTOR" || user.role === "ADMIN")) { %>

                <a
                    href="/patients"
                    class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
                >
                    Patients
                </a>

            <% } %>


            <!-- AI Assistant - Patient/Doctor -->

            <% if (user && (user.role === "PATIENT" || user.role === "DOCTOR")) { %>

                <a
                    href="/ai-assistant"
                    class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
                >
                    AI Assistant
                </a>

            <% } %>


            <!-- Telemedicine - Patient/Doctor -->

            <% if (user && (user.role === "PATIENT" || user.role === "DOCTOR")) { %>

                <a
                    href="/telemedicine"
                    class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
                >
                    Telemedicine
                </a>

            <% } %>


            <!-- Medicine - All authenticated users -->

            <% if (user) { %>

                <a
                    href="/medicine"
                    class="text-gray-700 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-medium"
                >
                    Medicine
                </a>

            <% } %>


            <!-- Mobile Authentication -->

            <div class="border-t border-gray-100 mt-3 pt-3">

                <% if (user) { %>

                    <div class="px-3 py-2">

                        <div class="flex items-center gap-3 mb-3">

                            <!-- Avatar -->

                            <div
                                class="w-10 h-10 rounded-full bg-blue-100 text-blue-600 flex items-center justify-center"
                            >
                                <i class="fa-solid fa-user"></i>
                            </div>


                            <!-- User Details -->

                            <div>

                                <p class="font-semibold text-gray-800">
                                    <%= user.name %>
                                </p>

                                <p class="text-xs text-gray-500">
                                    <%= user.role %>
                                </p>

                            </div>

                        </div>


                        <!-- Logout -->

                        <form method="POST" action="/logout">

                            <button
                                type="submit"
                                class="w-full text-left px-3 py-2 text-red-600 font-semibold hover:bg-red-50 rounded-md"
                            >

                                <i class="fa-solid fa-right-from-bracket mr-2"></i>

                                Logout

                            </button>

                        </form>

                    </div>

                <% } else { %>

                    <!-- Login -->

                    <a
                        href="/login"
                        class="text-blue-600 hover:bg-blue-50 block px-3 py-2 rounded-md text-base font-semibold"
                    >

                        <i class="fa-solid fa-right-to-bracket mr-2"></i>

                        Login

                    </a>


                    <!-- Register -->

                    <a
                        href="/register"
                        class="text-white bg-blue-600 hover:bg-blue-700 block px-3 py-2 rounded-md text-base font-semibold mt-1"
                    >

                        <i class="fa-solid fa-user-plus mr-2"></i>

                        Register

                    </a>

                <% } %>

            </div>

        </div>

    </div>

</nav>


<script>

const mobileMenuButton =
    document.getElementById("mobile-menu-button");

const mobileMenu =
    document.getElementById("mobile-menu");

if (mobileMenuButton && mobileMenu) {

    mobileMenuButton.addEventListener("click", () => {

        mobileMenu.classList.toggle("hidden");

        const icon = mobileMenuButton.querySelector("i");

        if (icon) {

            icon.classList.toggle("fa-bars");
            icon.classList.toggle("fa-xmark");

        }

    });

}

</script>