<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Patient Management</h1>
            <p class="text-muted">
                Manage patient information and healthcare records.
            </p>
        </div>

        <button
            class="btn btn-primary"
            id="addPatientBtn"
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#patientModal"
        >
            + Add Patient
        </button>
    </div>

    <!-- Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <label for="patientSearch" class="form-label">
                Search Patients
            </label>

            <input
                type="text"
                id="patientSearch"
                class="form-control"
                placeholder="Search by patient name or phone number..."
            >

        </div>
    </div>

    <!-- Patient Table -->
    <div class="card shadow-sm">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Registered Patients</h4>

                <span
                    id="patientCount"
                    class="badge bg-secondary"
                >
                    0 Patients
                </span>
            </div>

            <div id="patientMessage"></div>

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>Patient ID</th>
                            <th>Name</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Phone</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="patientTableBody">

                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                Loading patients...
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- Add Patient Modal -->
<div
    class="modal fade"
    id="patientModal"
    tabindex="-1"
    aria-labelledby="patientModalLabel"
    aria-hidden="true"
>

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5
                    class="modal-title"
                    id="patientModalLabel"
                >
                    Add New Patient
                </h5>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal"
                    aria-label="Close"
                ></button>

            </div>

            <form id="patientForm">

                <div class="modal-body">

                    <div id="formMessage"></div>

                    <div class="row g-3">

                        <!-- Patient ID -->
                        <div class="col-md-6">

                            <label
                                for="patientId"
                                class="form-label"
                            >
                                Patient ID *
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="patientId"
                                name="patientId"
                                placeholder="e.g. PAT-001"
                                required
                            >

                        </div>

                        <!-- Gender -->
                        <div class="col-md-6">

                            <label
                                for="gender"
                                class="form-label"
                            >
                                Gender
                            </label>

                            <select
                                class="form-select"
                                id="gender"
                                name="gender"
                            >
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>

                        </div>

                        <!-- First Name -->
                        <div class="col-md-6">

                            <label
                                for="firstName"
                                class="form-label"
                            >
                                First Name *
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="firstName"
                                name="firstName"
                                required
                            >

                        </div>

                        <!-- Last Name -->
                        <div class="col-md-6">

                            <label
                                for="lastName"
                                class="form-label"
                            >
                                Last Name *
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="lastName"
                                name="lastName"
                                required
                            >

                        </div>

                        <!-- Date of Birth -->
                        <div class="col-md-6">

                            <label
                                for="dateOfBirth"
                                class="form-label"
                            >
                                Date of Birth
                            </label>

                            <input
                                type="date"
                                class="form-control"
                                id="dateOfBirth"
                                name="dateOfBirth"
                            >

                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">

                            <label
                                for="phone"
                                class="form-label"
                            >
                                Phone *
                            </label>

                            <input
                                type="tel"
                                class="form-control"
                                id="phone"
                                name="phone"
                                placeholder="10-digit mobile number"
                                required
                            >

                        </div>

                        <!-- Email -->
                        <div class="col-md-6">

                            <label
                                for="email"
                                class="form-label"
                            >
                                Email
                            </label>

                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                            >

                        </div>

                        <!-- Blood Group -->
                        <div class="col-md-6">

                            <label
                                for="bloodGroup"
                                class="form-label"
                            >
                                Blood Group
                            </label>

                            <select
                                class="form-select"
                                id="bloodGroup"
                                name="bloodGroup"
                            >
                                <option value="">Select Blood Group</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>

                        </div>

                        <!-- Address -->
                        <div class="col-12">

                            <label
                                for="address"
                                class="form-label"
                            >
                                Address
                            </label>

                            <textarea
                                class="form-control"
                                id="address"
                                name="address"
                                rows="2"
                            ></textarea>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="savePatientBtn"
                    >
                        Save Patient
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


<script src="/js/patients.js"></script>