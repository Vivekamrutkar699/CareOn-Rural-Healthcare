<div class="min-h-[60vh] flex items-center justify-center">

    <div class="max-w-md w-full text-center">

        <div
            class="w-20 h-20 mx-auto rounded-full bg-red-100 text-red-600 flex items-center justify-center mb-6"
        >
            <i class="fa-solid fa-shield-halved text-3xl"></i>
        </div>

        <h1 class="text-4xl font-bold text-gray-800 mb-3">
            Access Denied
        </h1>

        <p class="text-gray-500 mb-2">
            You don't have permission to access this section.
        </p>

        <p class="text-sm text-gray-400 mb-8">
            Your current role:
            <span class="font-semibold text-gray-600">
                <%= user?.role || "Unknown" %>
            </span>
        </p>

        <a
            href="/dashboard"
            class="inline-flex items-center px-5 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition"
        >
            <i class="fa-solid fa-arrow-left mr-2"></i>
            Back to Dashboard
        </a>

    </div>

</div>