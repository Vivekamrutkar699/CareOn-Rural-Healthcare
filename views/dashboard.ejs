<div class="container mx-auto py-4">

    <!-- Dashboard Header -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-800">
            CareOn Dashboard
        </h1>

        <p class="text-gray-500 mt-1">
            AI-powered rural healthcare management platform
        </p>
    </div>


    <!-- Statistics -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">

        <!-- Total Patients -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">
                        Total Patients
                    </p>

                    <h2
                        id="totalPatients"
                        class="text-3xl font-bold text-gray-800 mt-2"
                    >
                        Loading...
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Registered patients
                    </p>
                </div>

                <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
                    <i class="fa-solid fa-user-injured text-blue-600 text-xl"></i>
                </div>
            </div>

        </div>


        <!-- Appointments -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">
                        Appointments
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-2">
                        0
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Upcoming appointments
                    </p>
                </div>

                <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center">
                    <i class="fa-solid fa-calendar-check text-green-600 text-xl"></i>
                </div>
            </div>

        </div>


        <!-- AI Analyses -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">
                        AI Analyses
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-2">
                        0
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Health analyses
                    </p>
                </div>

                <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
                    <i class="fa-solid fa-robot text-purple-600 text-xl"></i>
                </div>
            </div>

        </div>


        <!-- Medicines -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-gray-500">
                        Medicines
                    </p>

                    <h2 class="text-3xl font-bold text-gray-800 mt-2">
                        0
                    </h2>

                    <p class="text-sm text-gray-500 mt-1">
                        Medicine records
                    </p>
                </div>

                <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center">
                    <i class="fa-solid fa-pills text-orange-600 text-xl"></i>
                </div>
            </div>

        </div>

    </div>


    <!-- Main Features -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Patient Management -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center gap-4 mb-4">

                <div class="w-12 h-12 rounded-lg bg-blue-100 flex items-center justify-center">
                    <i class="fa-solid fa-users text-blue-600 text-xl"></i>
                </div>

                <h2 class="text-xl font-semibold text-gray-800">
                    Patient Management
                </h2>

            </div>

            <p class="text-gray-500 mb-5">
                Register patients, maintain health records and
                access patient information.
            </p>

            <a
                href="/patients"
                class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
            >
                Manage Patients
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <!-- AI Health Assistant -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center gap-4 mb-4">

                <div class="w-12 h-12 rounded-lg bg-purple-100 flex items-center justify-center">
                    <i class="fa-solid fa-robot text-purple-600 text-xl"></i>
                </div>

                <h2 class="text-xl font-semibold text-gray-800">
                    AI Health Assistant
                </h2>

            </div>

            <p class="text-gray-500 mb-5">
                Analyze health images and medical reports using
                Gemini AI.
            </p>

            <a
                href="/ai-assistant"
                class="inline-flex items-center gap-2 px-4 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition"
            >
                Open AI Assistant
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <!-- Telemedicine -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center gap-4 mb-4">

                <div class="w-12 h-12 rounded-lg bg-green-100 flex items-center justify-center">
                    <i class="fa-solid fa-video text-green-600 text-xl"></i>
                </div>

                <h2 class="text-xl font-semibold text-gray-800">
                    Telemedicine
                </h2>

            </div>

            <p class="text-gray-500 mb-5">
                Connect patients with healthcare professionals
                through remote consultations.
            </p>

            <a
                href="/telemedicine"
                class="inline-flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition"
            >
                Open Telemedicine
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>


        <!-- Medicine Management -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">

            <div class="flex items-center gap-4 mb-4">

                <div class="w-12 h-12 rounded-lg bg-orange-100 flex items-center justify-center">
                    <i class="fa-solid fa-pills text-orange-600 text-xl"></i>
                </div>

                <h2 class="text-xl font-semibold text-gray-800">
                    Medicine Management
                </h2>

            </div>

            <p class="text-gray-500 mb-5">
                Manage medicine availability and healthcare
                delivery information.
            </p>

            <a
                href="/medicine"
                class="inline-flex items-center gap-2 px-4 py-2 bg-orange-600 text-white rounded-lg hover:bg-orange-700 transition"
            >
                Manage Medicines
                <i class="fa-solid fa-arrow-right"></i>
            </a>

        </div>

    </div>

</div>


<!-- Dashboard JavaScript -->
<script src="/js/dashboard.js"></script>