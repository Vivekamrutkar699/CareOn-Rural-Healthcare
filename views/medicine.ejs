<% layout = 'layout/boilerplate' %>

<div class="max-w-7xl mx-auto">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="mb-10">

        <div class="flex flex-col md:flex-row md:items-center
                    md:justify-between gap-5">

            <div class="flex items-start gap-4">

                <div
                    class="w-12 h-12 shrink-0 rounded-xl
                           bg-orange-100 text-orange-600
                           flex items-center justify-center"
                >
                    <i class="fa-solid fa-pills text-xl"></i>
                </div>

                <div>
                    <h1 class="text-3xl md:text-4xl font-bold text-gray-800">
                        Medicine & Community Health
                    </h1>

                    <p class="text-gray-500 mt-2 max-w-2xl">
                        Find local health workers, access community
                        healthcare resources, and connect with organizations
                        supporting rural healthcare.
                    </p>
                </div>

            </div>

            <div
                class="flex items-center gap-2 px-4 py-2
                       rounded-full bg-green-50
                       text-green-700 text-sm font-semibold"
            >
                <i class="fa-solid fa-circle-check"></i>
                Community Support
            </div>

        </div>

    </section>


    <!-- =====================================================
         COMMUNITY HEALTH / ASHA INTRODUCTION
    ====================================================== -->

    <section class="mb-10">

        <div
            class="bg-white rounded-2xl shadow-sm
                   border border-gray-100 overflow-hidden"
        >

            <div class="grid grid-cols-1 lg:grid-cols-2">

                <!-- Information -->

                <div class="p-6 md:p-8 lg:p-10">

                    <div
                        class="inline-flex items-center gap-2
                               px-3 py-1.5 rounded-full
                               bg-blue-50 text-blue-600
                               text-xs font-semibold mb-4"
                    >
                        <i class="fa-solid fa-heart-pulse"></i>
                        Community Healthcare
                    </div>

                    <h2
                        class="text-2xl md:text-3xl
                               font-bold text-gray-800 mb-4"
                    >
                        The ASHA Worker:
                        <span class="text-blue-600">
                            Our Community's Healthline
                        </span>
                    </h2>

                    <p class="text-gray-500 leading-relaxed mb-5">
                        An Accredited Social Health Activist (ASHA) is a
                        trained female community health worker who acts as
                        an important point of contact for health-related
                        needs in her village.
                    </p>

                    <div class="space-y-4">

                        <div class="flex items-start gap-3">

                            <div
                                class="w-8 h-8 shrink-0 rounded-lg
                                       bg-green-100 text-green-600
                                       flex items-center justify-center"
                            >
                                <i class="fa-solid fa-baby"></i>
                            </div>

                            <p class="text-sm text-gray-600 leading-relaxed">
                                Supports maternal and child health services,
                                including antenatal care and immunization.
                            </p>

                        </div>


                        <div class="flex items-start gap-3">

                            <div
                                class="w-8 h-8 shrink-0 rounded-lg
                                       bg-purple-100 text-purple-600
                                       flex items-center justify-center"
                            >
                                <i class="fa-solid fa-apple-whole"></i>
                            </div>

                            <p class="text-sm text-gray-600 leading-relaxed">
                                Provides guidance on nutrition, family
                                planning, and basic sanitation.
                            </p>

                        </div>


                        <div class="flex items-start gap-3">

                            <div
                                class="w-8 h-8 shrink-0 rounded-lg
                                       bg-orange-100 text-orange-600
                                       flex items-center justify-center"
                            >
                                <i class="fa-solid fa-pills"></i>
                            </div>

                            <p class="text-sm text-gray-600 leading-relaxed">
                                Helps communities access essential medicines
                                and basic healthcare resources.
                            </p>

                        </div>


                        <div class="flex items-start gap-3">

                            <div
                                class="w-8 h-8 shrink-0 rounded-lg
                                       bg-blue-100 text-blue-600
                                       flex items-center justify-center"
                            >
                                <i class="fa-solid fa-people-group"></i>
                            </div>

                            <p class="text-sm text-gray-600 leading-relaxed">
                                Mobilizes communities for health awareness
                                and outreach programs.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- ASHA Image Slider -->

                <div
                    id="asha-slider"
                    class="relative min-h-[320px]
                           lg:min-h-full bg-gray-100 overflow-hidden"
                >

                    <!-- Slide 1 -->

                    <div
                        class="slide absolute inset-0
                               transition-opacity duration-700
                               ease-in-out opacity-100"
                    >
                        <img
                            src="https://drreddysfoundation.org/wp-content/uploads/2022/12/ArticlesBlog-pictures_ASHAs.jpg"
                            class="w-full h-full object-cover"
                            alt="ASHA worker providing community healthcare"
                        >

                        <div
                            class="absolute inset-0
                                   bg-gradient-to-t
                                   from-black/60 via-black/10 to-transparent"
                        ></div>

                        <div
                            class="absolute bottom-5 left-5 right-5"
                        >
                            <p class="text-white font-semibold">
                                Community Healthcare
                            </p>

                            <p class="text-white/80 text-sm mt-1">
                                Supporting healthcare access in rural communities.
                            </p>
                        </div>
                    </div>


                    <!-- Slide 2 -->

                    <div
                        class="slide absolute inset-0
                               transition-opacity duration-700
                               ease-in-out opacity-0"
                    >
                        <img
                            src="https://th-i.thgim.com/public/news/cities/bangalore/dpiq7g/article31428114.ece/alternates/FREE_1200/25BGASHAWORKERSP2"
                            class="w-full h-full object-cover"
                            alt="ASHA worker counseling women"
                        >
                    </div>


                    <!-- Slide 3 -->

                    <div
                        class="slide absolute inset-0
                               transition-opacity duration-700
                               ease-in-out opacity-0"
                    >
                        <img
                            src="https://media.assettype.com/tnm/import/sites/default/files/ASHA_worker_vaccine_children_1200_PTI_23052022-compressed.jpg?w=1200&h=675&auto=format%2Ccompress&fit=max&enlarge=true"
                            class="w-full h-full object-cover"
                            alt="Rural vaccination program"
                        >
                    </div>


                    <!-- Slide 4 -->

                    <div
                        class="slide absolute inset-0
                               transition-opacity duration-700
                               ease-in-out opacity-0"
                    >
                        <img
                            src="https://asha-india.org/wp-content/uploads/2022/05/272848725_4842299522525409_7601443845135435100_n.jpg"
                            class="w-full h-full object-cover"
                            alt="Community health worker"
                        >
                    </div>


                    <!-- Previous -->

                    <button
                        id="prev-slide"
                        type="button"
                        aria-label="Previous slide"
                        class="absolute top-1/2 left-4
                               -translate-y-1/2
                               w-10 h-10 rounded-full
                               bg-black/40 text-white
                               hover:bg-black/60
                               transition flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>


                    <!-- Next -->

                    <button
                        id="next-slide"
                        type="button"
                        aria-label="Next slide"
                        class="absolute top-1/2 right-4
                               -translate-y-1/2
                               w-10 h-10 rounded-full
                               bg-black/40 text-white
                               hover:bg-black/60
                               transition flex items-center
                               justify-center"
                    >
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>


                    <!-- Slide Indicators -->

                    <div
                        id="slide-indicators"
                        class="absolute bottom-5
                               right-5 flex gap-1.5"
                    ></div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FIND ASHA WORKER
    ====================================================== -->

    <section class="mb-10">

        <div
            class="bg-white rounded-2xl shadow-sm
                   border border-gray-100 p-6 md:p-8"
        >

            <div class="mb-6">

                <div class="flex items-center gap-3">

                    <div
                        class="w-10 h-10 rounded-xl
                               bg-green-100 text-green-600
                               flex items-center justify-center"
                    >
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div>

                        <h2 class="text-2xl font-bold text-gray-800">
                            Find Your Local ASHA Worker
                        </h2>

                        <p class="text-sm text-gray-500 mt-1">
                            Search for community health workers in your area.
                        </p>

                    </div>

                </div>

            </div>


            <!-- Search Controls -->

            <div
                class="grid grid-cols-1 md:grid-cols-2
                       lg:grid-cols-4 gap-4"
            >

                <!-- State -->

                <div>

                    <label
                        for="state-select"
                        class="block text-sm font-semibold
                               text-gray-700 mb-2"
                    >
                        State
                    </label>

                    <select
                        id="state-select"
                        class="w-full px-4 py-3 rounded-xl
                               border border-gray-200
                               bg-white text-gray-700
                               focus:outline-none
                               focus:ring-2 focus:ring-blue-500/30
                               focus:border-blue-500"
                    >
                        <option value="">
                            Select State
                        </option>

                        <option value="Maharashtra">
                            Maharashtra
                        </option>
                    </select>

                </div>


                <!-- District -->

                <div>

                    <label
                        for="district-select"
                        class="block text-sm font-semibold
                               text-gray-700 mb-2"
                    >
                        District
                    </label>

                    <select
                        id="district-select"
                        disabled
                        class="w-full px-4 py-3 rounded-xl
                               border border-gray-200
                               bg-gray-50 text-gray-500
                               disabled:cursor-not-allowed
                               focus:outline-none
                               focus:ring-2 focus:ring-blue-500/30
                               focus:border-blue-500"
                    >
                        <option value="">
                            Select District
                        </option>
                    </select>

                </div>


                <!-- Block -->

                <div>

                    <label
                        for="block-select"
                        class="block text-sm font-semibold
                               text-gray-700 mb-2"
                    >
                        Block
                    </label>

                    <select
                        id="block-select"
                        disabled
                        class="w-full px-4 py-3 rounded-xl
                               border border-gray-200
                               bg-gray-50 text-gray-500
                               disabled:cursor-not-allowed
                               focus:outline-none
                               focus:ring-2 focus:ring-blue-500/30
                               focus:border-blue-500"
                    >
                        <option value="">
                            Select Block
                        </option>
                    </select>

                </div>


                <!-- Village -->

                <div>

                    <label
                        for="village-search"
                        class="block text-sm font-semibold
                               text-gray-700 mb-2"
                    >
                        Village / Ward
                    </label>

                    <input
                        id="village-search"
                        type="text"
                        disabled
                        placeholder="Search village..."
                        class="w-full px-4 py-3 rounded-xl
                               border border-gray-200
                               bg-gray-50 text-gray-700
                               disabled:cursor-not-allowed
                               focus:outline-none
                               focus:ring-2 focus:ring-blue-500/30
                               focus:border-blue-500"
                    >

                </div>

            </div>


            <!-- Buttons -->

            <div
                class="flex flex-col sm:flex-row
                       gap-3 mt-5"
            >

                <button
                    id="search-btn"
                    type="button"
                    class="px-6 py-3 rounded-xl
                           bg-blue-600 text-white
                           font-semibold
                           hover:bg-blue-700
                           transition
                           flex items-center
                           justify-center gap-2"
                >
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search Workers
                </button>


                <button
                    id="near-me-btn"
                    type="button"
                    class="px-6 py-3 rounded-xl
                           bg-gray-100 text-gray-700
                           font-semibold
                           hover:bg-gray-200
                           transition
                           flex items-center
                           justify-center gap-2"
                >
                    <i class="fa-solid fa-location-crosshairs"></i>
                    Near Me
                </button>

            </div>


            <!-- Results -->

            <div
                id="asha-results-container"
                class="mt-7"
            ></div>

        </div>

    </section>


    <!-- =====================================================
         HEALTHCARE RESOURCES
    ====================================================== -->

    <section>

        <div class="mb-6">

            <h2
                class="text-2xl md:text-3xl
                       font-bold text-gray-800"
            >
                Rural Healthcare Partners
            </h2>

            <p class="text-gray-500 mt-1">
                Organizations working to improve healthcare access
                across underserved communities.
            </p>

        </div>


        <div
            id="partner-container"
            class="grid grid-cols-1 md:grid-cols-2
                   lg:grid-cols-3 gap-6"
        ></div>

    </section>

</div>

<script src="/js/medicine.js"></script>