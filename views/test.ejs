                        <th class="p-4 text-left text-sm font-semibold text-gray-600">Patient Name</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-600">Condition</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-600">Last Updated</th>
                        <th class="p-4 text-left text-sm font-semibold text-gray-600">Actions</th>
