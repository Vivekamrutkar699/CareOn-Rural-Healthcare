<% layout = 'layout/boilerplate' %>

<!-- Include the Chart.js library for data visualization -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* Custom styles for better visual feedback */
    .form-input {
        transition: all 0.3s ease;
    }
    .form-input:focus {
        box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.4);
        border-color: #3B82F6;
    }
    /* Styles for the new modal */
    #details-modal.hidden {
        display: none;
    }
</style>

<!-- Header Section -->
<header class="text-center mb-10">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-800">Doctor's Dashboard</h1>
    <p class="text-gray-600 mt-2">A central hub for patient management and tracking chronic conditions.</p>
</header>

<!-- Main Dashboard Content -->
<div class="space-y-12">
    
    <!-- Quick Stats Section (No Changes) -->
    <section>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="stat-card text-center">
                <i class="fa-solid fa-users text-4xl text-blue-500 mb-3"></i>
                <p class="text-3xl font-bold text-gray-800">152</p>
                <p class="text-gray-500">Total Patients</p>
            </div>
            <div class="stat-card text-center">
                <i class="fa-solid fa-heart-pulse text-4xl text-red-500 mb-3"></i>
                <p class="text-3xl font-bold text-gray-800">34</p>
                <p class="text-gray-500">Chronic Conditions Monitored</p>
            </div>
            <div class="stat-card text-center">
                <i class="fa-solid fa-calendar-check text-4xl text-green-500 mb-3"></i>
                <p class="text-3xl font-bold text-gray-800">8</p>
                <p class="text-gray-500">Upcoming Appointments</p>
            </div>
        </div>
    </section>

    <!-- Easy Data Entry Section (No Changes) -->
    <!-- Combined Section: Add Patient & Watchlist Side by Side -->
<section class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    
    <!-- Left: Add New Patient Record -->
    <div class="bg-white p-8 rounded-lg shadow-lg border border-gray-200">
        <h2 class="text-2xl font-bold text-gray-800 mb-4 border-b pb-3">
            <i class="fa-solid fa-user-plus mr-2 text-gray-600"></i> Add New Patient Record
        </h2>
        <form id="add-patient-form" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="patient-name" class="block text-sm font-medium text-gray-700 mb-1">Patient Full Name</label>
                <input type="text" id="patient-name" class="form-input w-full p-2 border border-gray-300 rounded-md" required>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="patient-age" class="block text-sm font-medium text-gray-700 mb-1">Age</label>
                    <input type="number" id="patient-age" class="form-input w-full p-2 border border-gray-300 rounded-md" required>
                </div>
                <div>
                    <label for="patient-gender" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                    <select id="patient-gender" class="form-input w-full p-2 border border-gray-300 rounded-md">
                        <option>Male</option>
                        <option>Female</option>
                        <option>Other</option>
                    </select>
                </div>
            </div>
            <div>
                <label for="chronic-condition" class="block text-sm font-medium text-gray-700 mb-1">Chronic Condition (if any)</label>
                <select id="chronic-condition" class="form-input w-full p-2 border border-gray-300 rounded-md">
                    <option value="None">None</option>
                    <option value="Diabetes">Diabetes</option>
                    <option value="Hypertension">Hypertension</option>
                    <option value="Asthma">Asthma</option>
                    <option value="Tuberculosis">Tuberculosis</option>
                </select>
            </div>
            <div>
                <label for="condition-notes" class="block text-sm font-medium text-gray-700 mb-1">Condition Notes</label>
                <input type="text" id="condition-notes" class="form-input w-full p-2 border border-gray-300 rounded-md" placeholder="e.g., Type 2, diagnosed 2021">
            </div>
            <div class="md:col-span-2 text-right">
                <button type="submit" class="bg-blue-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-blue-700 transition">
                    Add Patient
                </button>
            </div>
        </form>
    </div>

    <!-- Right: Chronic Condition Watchlist -->
    <div>
        <h2 class="text-2xl font-bold text-gray-800 mb-4">
            <i class="fa-solid fa-list-check mr-2 text-gray-600"></i> Chronic Condition Watchlist
        </h2>
        <div class="bg-white rounded-lg shadow-lg border border-gray-200 overflow-hidden">
