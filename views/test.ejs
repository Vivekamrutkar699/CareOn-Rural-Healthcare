</div>

<!-- MODAL FOR PATIENT DETAILS -->
<div id="details-modal" class="fixed inset-0 bg-black bg-opacity-60 z-50 hidden flex items-center justify-center">
    <div class="bg-gray-50 p-8 rounded-lg shadow-2xl w-full max-w-4xl transform transition-all m-4">
        <!-- Modal Header -->
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div>
                <h2 id="modal-patient-name" class="text-3xl font-bold text-gray-800">Patient Name</h2>
                <p id="modal-patient-condition" class="text-lg text-gray-600">Condition</p>
            </div>
            <button id="close-modal-btn" class="text-gray-500 hover:text-gray-800 text-4xl leading-none">&times;</button>
        </div>
        
        <!-- Modal Body -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Left Column: Data Visualization -->
            <div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">Health Trend</h3>
                <div class="bg-white p-4 rounded-lg shadow border">
                    <canvas id="health-chart"></canvas>
                </div>
            </div>
            <!-- Right Column: AI Recommendations -->
            <div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">
                    <i class="fa-solid fa-robot mr-2"></i> AI-Powered Recommendations
                </h3>
                <div id="ai-recommendation" class="bg-white p-4 rounded-lg shadow border h-80 overflow-y-auto prose">
                    <!-- AI content will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Link to the JavaScript file that will power this page -->
<script src="/js/dashboard.js"></script>

