generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Patient {
  id          String   @id @default(uuid())
  patientId   String   @unique
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      String?
  phone       String
  email       String?
  address     String?
  bloodGroup  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}